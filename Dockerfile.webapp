FROM python:3.12-slim

# == Railway: в настройках СЕРВИСА «webapp» обязательно: ==
#   Source / Root Directory = ПУСТО (корень репозитория, где рядом app/ и webapp/).
#   НЕ указывайте "webapp" — иначе COPY webapp/... и COPY app/ не существуют в контексте.
#   Build: Dockerfile path = Dockerfile.webapp (этот файл в корне) ИЛИ webapp/Dockerfile.
# Локально:  docker build -f Dockerfile.webapp -t sc-webapp .
# Алиас:     docker build -f webapp/Dockerfile -t sc-webapp .   (тот же рецепт)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

WORKDIR /app

COPY webapp/requirements.txt ./
RUN pip install -r requirements.txt

COPY app ./app
COPY webapp/index.html webapp/styles.css webapp/player.js webapp/server.py webapp/tg_webapp_auth.py /app/

EXPOSE 8080

CMD ["python", "server.py"]
