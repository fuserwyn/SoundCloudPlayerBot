FROM python:3.12-slim

# См. webapp/Dockerfile — тот же образ. Сборка: docker build -f Dockerfile.webapp .
# Railway: Root Directory = корень репо (не webapp). См. комментарий в webapp/Dockerfile.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

WORKDIR /app

COPY webapp/requirements.txt ./
RUN pip install -r requirements.txt

COPY app ./app
COPY webapp/index.html webapp/styles.css webapp/player.js webapp/server.py webapp/tg_webapp_auth.py /app/

EXPOSE 8080

CMD ["python", "server.py"]
